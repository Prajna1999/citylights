{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://haat.local/schema/establishment.schema.json",
  "title": "Establishment",
  "description": "A shop, eatery, clinic, gym or other establishment in the Bhadrak directory. Shaped for document-DB migration (MongoDB/DocumentDB): one record per establishment, GeoJSON point for geospatial queries.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "category_id",
    "status",
    "location",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "id": { "type": "string", "description": "Stable unique id (place_id from Google when scraped, else a generated slug/uuid)." },
    "name": { "type": "string", "minLength": 1 },
    "name_local": { "type": "string", "description": "Local script (Odia) name." },
    "category_id": { "type": "string", "description": "Reference to a category in data/categories.json." },
    "category_name": { "type": "string", "description": "Denormalised category name for easy reads." },
    "subcategory": { "type": "array", "items": { "type": "string" }, "description": "Google place types / finer tags." },
    "owner_name": { "type": "string" },
    "description": { "type": "string" },
    "phone": { "type": "string", "description": "E.164-ish national/international number." },
    "whatsapp": { "type": "string" },
    "address": {
      "type": "object",
      "properties": {
        "line": { "type": "string" },
        "landmark": { "type": "string", "description": "How people actually navigate, e.g. near Bankabasuli Temple." },
        "locality": { "type": "string" },
        "district": { "type": "string" },
        "state": { "type": "string" },
        "pincode": { "type": "string" },
        "country": { "type": "string" }
      }
    },
    "location": {
      "type": "object",
      "description": "GeoJSON Point. Note: coordinates are [longitude, latitude].",
      "required": ["type", "coordinates"],
      "properties": {
        "type": { "type": "string", "enum": ["Point"] },
        "coordinates": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } }
      }
    },
    "hours": {
      "type": "array",
      "description": "Weekly slots. Multiple rows per day = lunch-break split. No row for a day = closed.",
      "items": {
        "type": "object",
        "properties": {
          "day_of_week": { "type": "integer", "minimum": 0, "maximum": 6 },
          "open_time": { "type": "string" },
          "close_time": { "type": "string" },
          "note": { "type": "string" }
        }
      }
    },
    "photos": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": { "type": "string" },
          "is_primary": { "type": "boolean" },
          "attribution": { "type": "string" }
        }
      }
    },
    "rating": { "type": "number", "description": "Google rating 0-5, when available." },
    "user_ratings_total": { "type": "integer" },
    "price_level": { "type": "integer", "description": "0-4 as returned by Google." },
    "status": { "type": "string", "enum": ["active", "temporarily_closed", "permanently_closed"] },
    "last_verified_at": { "type": "string", "description": "ISO timestamp. Null if never verified." },
    "created_at": { "type": "string", "description": "ISO timestamp." },
    "updated_at": { "type": "string", "description": "ISO timestamp." },
    "source": {
      "type": "object",
      "properties": {
        "provider": { "type": "string", "enum": ["google_places", "manual_curated", "openstreetmap"] },
        "place_id": { "type": "string" },
        "scraped_at": { "type": "string" },
        "url": { "type": "string", "description": "Google Maps link." }
      }
    },
    "tags": { "type": "array", "items": { "type": "string" } },
    "meta": { "type": "object", "description": "Free-form: is_mock, requires_verification, source_note, etc." }
  }
}
